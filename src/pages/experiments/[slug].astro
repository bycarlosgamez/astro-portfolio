---
import { getCollection } from 'astro:content';
import { demoModules, demoPathForSlug, hasDemo } from '../../experiments/demo-registry';
import Main from '../../layouts/Main.astro';

export async function getStaticPaths() {
  const entries = await getCollection(
    'experiments',
    ({ data }) => data.published === true && data.display === 'full-page',
  );

  return entries.map((entry) => {
    if (!hasDemo(entry.id)) {
      throw new Error(
        `[experiments] "${entry.id}" is published full-page but src/experiments/demos/${entry.id}.astro is missing.`,
      );
    }
    return {
      params: { slug: entry.id },
      props: { slug: entry.id, title: entry.data.title },
    };
  });
}

const { slug, title } = Astro.props;
const load = demoModules[demoPathForSlug(slug)];
if (!load) {
  throw new Error(`Missing demo component for "${slug}"`);
}
const module = await load();
const Demo = module.default;
---

<Main title={`Carlos Gamez | ${title}`} bodyClass='experiments'>
  <main id='main' class='experiment-detail'>
    <p class='experiment-detail__back'>
      <a class='font-mono uppercase color-light' href='/experiments'>← Back to experiments</a>
    </p>
    <div class='experiment-detail__stage'>
      <Demo />
    </div>
  </main>
</Main>

<style>
  .experiment-detail {
    padding-inline: var(--experiment-layout-gutter, 1rem);
    padding-block: 1.25rem 0;
    min-height: calc(100dvh - clamp(5.5rem, 14vh, 9.5rem));
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  .experiment-detail__back {
    margin: 0 0 1rem;
    flex-shrink: 0;
  }

  .experiment-detail__stage {
    flex: 1;
    min-height: 0;
    display: grid;
    place-items: center;
  }
</style>
