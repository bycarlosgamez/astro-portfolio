---
import { getCollection, render } from 'astro:content';
import ExperimentCard from '../../components/ExperimentCard.astro';
import Main from '../../layouts/Main.astro';

export async function getStaticPaths() {
  const experiments = await getCollection('experiments', ({ data }) => data.kind === 'demo');
  return experiments.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
await render(entry);
const { title, description, demoEmbedUrl, externalUrl, meta } = entry.data;
---

<Main title={`Carlos Gamez | ${title}`} bodyClass='experiments'>
  <main id='main' class='experiment-demo flow'>
    <p>
      <a class='font-mono uppercase color-light' href='/experiments'
        >← Back to experiments</a
      >
    </p>

    <div class='experiment-demo__layout'>
      <div class='experiment-demo__preview'>
        {
          demoEmbedUrl && (
            <iframe
              title={`${title} demo`}
              src={demoEmbedUrl}
              loading='lazy'
              allowfullscreen
              sandbox='allow-scripts allow-same-origin allow-popups'
            />
          )
        }
      </div>
      <div class='experiment-demo__meta'>
        <ExperimentCard
          {title}
          {description}
          meta={meta}
          externalUrl={externalUrl}
          demoPage
        />
      </div>
    </div>
  </main>
</Main>

<style>
  .experiment-demo {
    padding-inline: var(--gutter, 1.5rem);
    padding-block: 2rem 4rem;
    max-width: 1200px;
    margin-inline: auto;
  }

  .experiment-demo__layout {
    display: grid;
    gap: 2rem;
    margin-top: 2rem;
  }

  .experiment-demo__preview {
    min-height: 420px;
    border: 1px solid hsl(var(--color-white) / 0.1);
    border-radius: 8px;
    overflow: hidden;
    background: hsl(var(--color-dark) / 0.5);
  }

  .experiment-demo__preview iframe {
    width: 100%;
    height: min(70vh, 640px);
    border: 0;
  }

  @media (min-width: 45em) {
    .experiment-demo__layout {
      grid-template-columns: 1.2fr 1fr;
      align-items: start;
    }
  }
</style>
