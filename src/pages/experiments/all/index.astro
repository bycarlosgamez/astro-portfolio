---
import Main from '../../../layouts/Main.astro';
---

<Main title='Carlos Gamez | All experiments' bodyClass='experiments'>
  <main id='main' class='experiment-all flow'>
    <h1 class='numbered-title'>
      <span aria-hidden='true'>01</span>All experiments
    </h1>
    <p class='color-light'>
      Full masonry grid coming soon. <a class='font-mono uppercase' href='/experiments'
        >Back to featured</a
      >
    </p>
  </main>
</Main>

<style>
  .experiment-all {
    text-align: start;
    padding-inline: 1rem;
    padding-block: 2rem 4rem;
    max-width: 65ch;
    margin-inline: auto;
  }
</style>
