---
import { getCollection } from 'astro:content';
import { embedModules, embedPathForSlug, hasEmbed } from '../../../experiments/embed-registry';
import '../../../styles/global.css';

export async function getStaticPaths() {
  const live = await getCollection('experiments', ({ data }) => data.preview === 'live');

  return live.filter((entry) => hasEmbed(entry.id)).map((entry) => ({
    params: { slug: entry.id },
    props: { slug: entry.id },
  }));
}

const { slug } = Astro.props;
const load = embedModules[embedPathForSlug(slug)];
if (!load) {
  throw new Error(`Missing embed component for "${slug}"`);
}
const module = await load();
const Demo = module.default;
---

<section class='experiment-section .experiment-embed-page'>
  <Demo />
</section>


<style is:global>
  .experiment-embed-page {
    margin: 0;
    min-height: 100dvh;
    box-sizing: border-box;
    display: grid;
    place-items: center;
    padding: 1rem;
    background: hsl(var(--color-dark));
  }
</style>
