---
import DesignSystem from '../../layouts/DesignSystem.astro';
---

<DesignSystem title='Carlos Gamez | Design System'>
  <div class='container'>
    <div>
      <h1>Design System</h1>
      <section id='colors' style='margin: 4rem 0'>
        <h2 class='numbered-title'><span>01</span> colors</h2>
        <div
          class='flex'
          style='justify-content: space-between; align-items: center;'
        >
          <div style='flex-grow: 1;'>
            <div style='padding: 3rem 1rem 1rem; border: 1px solid white'>
              #020617
            </div>
            <p><span class='color-light'>RGB</span> 2, 6, 23</p>
            <p><span class='color-light'>HSL</span> 229, 85%, 5%</p>
          </div>

          <div style='flex-grow: 1;'>
            <div
              style='padding: 3rem 1rem 1rem; border: 1px solid white'
              class='bg-accent color-dark'
            >
              #0d9488
            </div>
            <p><span class='color-light'>RGB</span> 13, 148, 136</p>
            <p><span class='color-light'>HSL</span> 174, 100%, 37%</p>
          </div>

          <div style='flex-grow: 1;'>
            <div
              style='padding: 3rem 1rem 1rem; border: 1px solid white'
              class='bg-light color-dark'
            >
              #e2e8f0
            </div>
            <p><span class='color-light'>RGB</span> 226, 232, 240</p>
            <p><span class='color-light'>HSL</span> 214, 32%, 91%</p>
          </div>

          <div style='flex-grow: 1;'>
            <div
              style='padding: 3rem 1rem 1rem; border: 1px solid white'
              class='bg-white color-dark'
            >
              #ffffff
            </div>
            <p><span class='color-light'>RGB</span> 255, 255, 255</p>
            <p><span class='color-light'>HSL</span> 0, 0%, 100%</p>
          </div>
        </div>
      </section>

      <section class='flow' id='typography' style='margin: 4rem 0'>
        <h2 class='numbered-title'><span>02 </span>Typography</h2>
        <div class='flex'>
          <div class='flow' style='flex-basis: 100%'>
            <div>
              <p>Heading 1 - IBM Plex Mono - 150px</p>
              <p class='color-light font-mono text-900 uppercase'>Design</p>
            </div>

            <div>
              <p>Heading 2 - IBM Plex Mono - 100px</p>
              <p class='color-light font-mono text-800 uppercase'>
                Engineering
              </p>
            </div>

            <div>
              <p>Heading 3 - IBM Plex Mono - 56px</p>
              <p class='color-light font-mono text-700 uppercase'>
                AI & Design Systems
              </p>
            </div>

            <div>
              <p>Heading 4 - IBM Plex Mono - 32px</p>
              <p class='color-light font-mono text-600 uppercase'>
                Build & manage design token system
              </p>
            </div>

            <div>
              <p>
                Heading 5 - IBM Plex Condensed Regular - 28px - 4.75 Character
                Space
              </p>
              <p
                class='color-light font-condensed text-500 uppercase tracking-2xl'
              >
                Consistency, Scale, and Craft
              </p>
            </div>
          </div>

          <div class='flow' style='flex-basis: 100%'>
            <div>
              <p class='color-light'>Subheading 1 - IBM Plex Mono - 28px</p>
              <p class='font-mono text-500 uppercase'>
                So, you want scalable UI foundations
              </p>
            </div>

            <div>
              <p class='color-light'>
                Subheading 2 - IBM Plex Condensed Regular - 14px - 2.35
                Character Space
              </p>
              <p class='font-condensed text-300 uppercase tracking-2xl'>
                Token-Driven Architecture
              </p>
            </div>

            <div>
              <p class='color-light'>
                Nav Text - IBM Plex Condensed Regular - 16px - 2.7 Character
                Space
              </p>
              <p class='font-condensed text-300 uppercase tracking-xl'>
                Components · Patterns · Guidelines
              </p>
            </div>

            <div>
              <p class='color-light'>Body Text</p>
              <p>
                This system demonstrates a structured approach to building
                resilient interfaces. It emphasizes semantic tokens, accessible
                typography, and scalable component architecture. The goal is to
                create alignment between design decisions and production
                implementation, ensuring consistency across products, teams, and
                platforms while maintaining clarity and performance.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class='flow' id='interactive-elements'>
        <h2 class='numbered-title'><span>03</span> Interactive elements</h2>

        <!-- NAVIGATION -->
        <div>
          <nav>
            <ul class='nav-primary underline-indicators flex'>
              <li class='active'>
                <a class='uppercase color-white tracking-xl' href='#'
                  ><span>01</span>Active</a
                >
              </li>
              <li>
                <a class='uppercase color-white tracking-xl' href='#'
                  ><span>02</span>Hovered</a
                >
              </li>
              <li>
                <a class='uppercase color-white tracking-xl' href='#'
                  ><span>03</span>Idle</a
                >
              </li>
            </ul>
          </nav>
        </div>

        <div class='flex'>
          <div style='margin-top: 5rem;'>
            <!-- LARGE BUTTON -->
            <a
              href='#'
              class='button-large uppercase font-mono color-dark text-600 bg-white'
              >Explore</a
            >
          </div>
          <div class='flow' style='margin-bottom: 50vh; --flow-space: 4rem'>
            <!-- TABS -->
            <div class='tab-list underline-indicators flex'>
              <button
                aria-selected='true'
                class='bg-dark font-condensed bg-dark uppercase color-light tracking-xl'
                >Experiments</button
              >
              <button
                aria-selected='false'
                class='bg-dark font-condensed bg-dark uppercase color-light tracking-xl'
                >Design</button
              >
              <button
                aria-selected='false'
                class='bg-dark font-condensed bg-dark uppercase color-light tracking-xl'
                >Development</button
              >
            </div>

            <!-- DOT INDICATORS -->
            <div class='dot-indicators flex'>
              <button aria-selected='true'
                ><span class='sr-only'>Slide title</span></button
              >
              <button aria-selected='false'
                ><span class='sr-only'>Slide title</span></button
              >
              <button aria-selected='false'
                ><span class='sr-only'>Slide title</span></button
              >
            </div>

            <!-- NUMBER INDICATORS -->
            <div class='number-indicators flex' style='flex-direction: column;'>
              <button aria-selected='true'>1</button>
              <button aria-selected='false'>2</button>
              <button aria-selected='false'>3</button>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</DesignSystem>
