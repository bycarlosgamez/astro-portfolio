---
import DesignSystem from '../../layouts/DesignSystem.astro';
---

<DesignSystem title='Carlos Gamez | Design System'>
  <div class='container'>
    <div>
      <h1>Design System</h1>
      <section id='colors' style='margin: 4rem 0'>
        <h2><span class='uppercase'>01</span> colors</h2>
        <div
          class='flex'
          style='justify-content: space-between; align-items: center;'
        >
          <div style='flex-grow: 1;'>
            <div style='padding: 3rem 1rem 1rem; border: 1px solid white'>
              #020617
            </div>
            <p><span class='text-light'>RGB</span> 2, 6, 23</p>
            <p><span class='text-light'>HSL</span> 229, 85%, 5%</p>
          </div>

          <div style='flex-grow: 1;'>
            <div
              style='padding: 3rem 1rem 1rem; border: 1px solid white'
              class='bg-light text-dark'
            >
              #e2e8f0
            </div>
            <p><span class='text-light'>RGB</span> 226, 232, 240</p>
            <p><span class='text-light'>HSL</span> 214, 32%, 91%</p>
          </div>

          <div style='flex-grow: 1;'>
            <div
              style='padding: 3rem 1rem 1rem; border: 1px solid white'
              class='bg-white text-dark'
            >
              #ffffff
            </div>
            <p><span class='text-light'>RGB</span> 255, 255, 255</p>
            <p><span class='text-light'>HSL</span> 0, 0%, 100%</p>
          </div>
        </div>
      </section>
    </div>
  </div>
</DesignSystem>
