---
import Main from '../../layouts/Main.astro';
---

<Main title='Carlos Gamez | Projects' bodyClass='projects'>
  <main id='main' class='projects-soon flow'>
    <h1 class='numbered-title numbered-title--compact projects-soon__section-title'>
      <span aria-hidden='true'>02</span>Selected projects
    </h1>
    <p class='projects-soon__lead text-700 font-condensed uppercase tracking-lg'>
      Coming soon
    </p>
    <p class='color-light'>
      Flagship case studies are in progress for this iteration. Explore
      <a class='font-mono uppercase' href='/experiments'>experiments</a
      >{' '}
      in the meantime.
    </p>
  </main>
</Main>

<style>
  .projects-soon {
    text-align: start;
    padding-inline: var(--experiment-layout-gutter, 1rem);
    padding-block: 2rem 4rem;
    max-width: 65ch;
    margin-inline: auto;
    box-sizing: border-box;
  }

  .projects-soon__section-title {
    margin: 0 0 1.75rem;
    color: hsl(var(--color-white));
  }

  .projects-soon__section-title > span:first-child {
    color: hsl(var(--color-white) / 0.25);
  }

  .projects-soon__lead {
    margin: 0 0 1rem;
    color: hsl(var(--color-white));
  }
</style>
