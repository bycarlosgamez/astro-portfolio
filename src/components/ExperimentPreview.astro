---
type MetaItem = { label: string; value: string };

type Props = {
  title: string;
  description: string;
  thumbnail?: string;
  meta?: MetaItem[];
  externalUrl?: string;
  detailHref?: string;
  showTitle?: boolean;
};

const {
  title,
  description,
  thumbnail,
  meta = [],
  externalUrl,
  detailHref,
  showTitle = true,
} = Astro.props;
---

<article class='experiment-preview flow'>
  {
    thumbnail && (
      <figure class='experiment-preview__figure'>
        <img src={thumbnail} alt='' width='640' height='360' loading='lazy' />
      </figure>
    )
  }

  {showTitle && (
    <h2 class='experiment-preview__title text-600 font-condensed uppercase'>{title}</h2>
  )}
  <p class='experiment-preview__description color-light'>{description}</p>

  {
    meta.length > 0 && (
      <dl class='experiment-preview__meta'>
        {meta.map((item) => (
          <>
            <dt class='color-light text-200 uppercase'>{item.label}</dt>
            <dd class='font-mono uppercase'>{item.value}</dd>
          </>
        ))}
      </dl>
    )
  }

  {
    (detailHref || externalUrl) && (
      <p class='experiment-preview__actions'>
        {
          detailHref && (
            <a class='experiment-preview__link font-mono uppercase' href={detailHref}>
              Open demo →
            </a>
          )
        }
        {
          externalUrl && (
            <a
              class='experiment-preview__link font-mono uppercase color-light'
              href={externalUrl}
              target='_blank'
              rel='noopener noreferrer'
            >
              View external ↗
            </a>
          )
        }
      </p>
    )
  }
</article>

<style>
  .experiment-preview__figure {
    margin: 0 0 1.5rem;

    & img {
      max-width: 100%;
      height: auto;
      border-radius: 8px;
      border: 1px solid hsl(var(--color-white) / 0.1);
    }
  }

  .experiment-preview__title {
    opacity: 0.9;
  }

  .experiment-preview__description {
    max-width: 55ch;
  }

  .experiment-preview__meta {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 1.5rem;
    margin: 1.5rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid hsl(var(--color-white) / 0.1);
  }

  .experiment-preview__meta dd {
    margin: 0;
  }

  .experiment-preview__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.75rem;
    margin-top: 1.75rem;
  }

  .experiment-preview__link {
    color: hsl(var(--color-white));
    text-decoration: none;
    border-bottom: 0.15rem solid hsl(var(--color-white) / 0.35);
    padding-bottom: 0.15rem;
  }

  .experiment-preview__link:hover,
  .experiment-preview__link:focus-visible {
    border-color: hsl(var(--color-white));
  }
</style>
