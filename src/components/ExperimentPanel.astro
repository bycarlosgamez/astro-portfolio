---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';

type MetaItem = { label: string; value: string };
type DisplayMode = 'inline' | 'full-page';

type Props = {
  slug: string;
  description: string;
  meta?: MetaItem[];
  externalUrl?: string;
  display: DisplayMode;
  title: string;
  thumbnail?: string;
  LiveDemo?: AstroComponentFactory;
};

const {
  slug,
  description,
  meta = [],
  externalUrl,
  display,
  title,
  thumbnail,
  LiveDemo,
} = Astro.props;

const detailHref = display === 'full-page' ? `/experiments/${slug}` : undefined;
---

<div class='experiment-panel flow flow-small'>
  <p class='experiment-panel__description color-light'>{description}</p>

  {
    meta.length > 0 && (
      <dl class='experiment-panel__meta'>
        {meta.map((item) => (
          <>
            <dt class='color-light text-200 uppercase'>{item.label}</dt>
            <dd class='font-mono uppercase'>{item.value}</dd>
          </>
        ))}
      </dl>
    )
  }

  {
    (detailHref || externalUrl) && (
      <p class='experiment-panel__actions'>
        {
          detailHref && (
            <a
              class='experiment-panel__link font-mono uppercase'
              href={detailHref}
              target='_blank'
              rel='noopener noreferrer'
            >
              Open exploration ↗
            </a>
          )
        }
        {
          externalUrl && (
            <a
              class='experiment-panel__link font-mono uppercase color-light'
              href={externalUrl}
              target='_blank'
              rel='noopener noreferrer'
            >
              View external ↗
            </a>
          )
        }
      </p>
    )
  }

  <div
    class='experiment-panel__preview'
    role='region'
    aria-label='Experiment preview'
    data-display={display}
  >
    {
      display === 'inline' && LiveDemo && <LiveDemo />
    }
    {
      display === 'inline' && !LiveDemo && (
        <p class='experiment-panel__empty color-light font-mono uppercase text-200'>
          Missing demo component for “{title}”.
        </p>
      )
    }
    {
      display === 'full-page' && thumbnail && (
        <figure class='experiment-panel__poster'>
          <img src={thumbnail} alt='' width='640' height='360' loading='lazy' />
        </figure>
      )
    }
  </div>
</div>

<style>
  .experiment-panel {
    --flow-space: 0.75rem;
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    max-height: 35rem;
  }

  .experiment-panel__description {
    max-width: 55ch;
    margin: 0;
    flex-shrink: 0;
  }

  .experiment-panel__meta {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 1.5rem;
    margin: 0;
    padding-top: 0.75rem;
    border-top: 1px solid hsl(var(--color-white) / 0.1);
    flex-shrink: 0;
  }

  .experiment-panel__meta dd {
    margin: 0;
  }

  .experiment-panel__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.75rem;
    margin: 0;
    flex-shrink: 0;
  }

  .experiment-panel__link {
    color: hsl(var(--color-white));
    text-decoration: none;
    border-bottom: 0.15rem solid hsl(var(--color-white) / 0.35);
    padding-bottom: 0.15rem;
  }

  .experiment-panel__link:hover,
  .experiment-panel__link:focus-visible {
    border-color: hsl(var(--color-white));
  }

  .experiment-panel__preview {
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 1px solid hsl(var(--color-white) / 0.08);
    border-radius: 8px;
    background: hsl(var(--color-dark) / 0.35);
    padding: 1rem;
    box-sizing: border-box;
  }

  .experiment-panel__poster {
    margin: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem;
    box-sizing: border-box;
  }

  .experiment-panel__poster img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 6px;
    border: 1px solid hsl(var(--color-white) / 0.1);
  }

  .experiment-panel__empty {
    margin: 0;
    padding: 1.5rem;
    text-align: center;
    max-width: 28ch;
  }
</style>
