---
type MetaItem = { label: string; value: string };

type Props = {
  description: string;
  meta?: MetaItem[];
  externalUrl?: string;
  detailHref?: string;
};

const { description, meta = [], externalUrl, detailHref } = Astro.props;
---

<div class='experiment-chrome flow flow-small'>
  <p class='experiment-chrome__description color-light'>{description}</p>

  {
    meta.length > 0 && (
      <dl class='experiment-chrome__meta'>
        {meta.map((item) => (
          <>
            <dt class='color-light text-200 uppercase'>{item.label}</dt>
            <dd class='font-mono uppercase'>{item.value}</dd>
          </>
        ))}
      </dl>
    )
  }

  {
    (detailHref || externalUrl) && (
      <p class='experiment-chrome__actions'>
        {
          detailHref && (
            <a class='experiment-chrome__link font-mono uppercase' href={detailHref}>
              Open demo →
            </a>
          )
        }
        {
          externalUrl && (
            <a
              class='experiment-chrome__link font-mono uppercase color-light'
              href={externalUrl}
              target='_blank'
              rel='noopener noreferrer'
            >
              View external ↗
            </a>
          )
        }
      </p>
    )
  }
</div>

<style>
  .experiment-chrome {
    --flow-space: 0.75rem;
  }

  .experiment-chrome__description {
    max-width: 55ch;
    margin: 0;
  }

  .experiment-chrome__meta {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 1.5rem;
    margin: 0;
    padding-top: 0.75rem;
    border-top: 1px solid hsl(var(--color-white) / 0.1);
  }

  .experiment-chrome__meta dd {
    margin: 0;
  }

  .experiment-chrome__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.75rem;
    margin: 0;
  }

  .experiment-chrome__link {
    color: hsl(var(--color-white));
    text-decoration: none;
    border-bottom: 0.15rem solid hsl(var(--color-white) / 0.35);
    padding-bottom: 0.15rem;
  }

  .experiment-chrome__link:hover,
  .experiment-chrome__link:focus-visible {
    border-color: hsl(var(--color-white));
  }
</style>
