---
type NavSection = 'home' | 'experiments' | 'projects' | 'about';

type Props = {
  currentSection?: NavSection;
};

const { currentSection } = Astro.props;

const navItems: { id: NavSection; href: string; index: string; label: string }[] =
  [
    { id: 'home', href: '/', index: '00', label: 'Home' },
    { id: 'experiments', href: '/experiments', index: '01', label: 'Experiments' },
    { id: 'projects', href: '/projects', index: '02', label: 'Projects' },
    { id: 'about', href: '/about', index: '03', label: 'About' },
  ];
---

<header class='header-primary flex'>
  <div>
    <img class='logo' src='../Logo.svg' alt='Carlos logo' />
  </div>
  <button
    class='mobile-nav-toggle'
    aria-controls='primary-navigation'
    aria-expanded='false'><span class='sr-only'>Menu</span></button
  >
  <nav>
    <ul
      id='primary-navigation'
      data-visible='false'
      class='nav-primary underline-indicators flex'
    >
      {
        navItems.map((item) => {
          const isActive = item.id === currentSection;
          return (
            <li class:list={{ active: isActive }}>
              <a
                class='font-condensed uppercase color-white tracking-xl'
                href={item.href}
                aria-current={isActive ? 'page' : undefined}
              >
                <span aria-hidden='true'>{item.index}</span>{item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>

<style>
  .header-primary {
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    margin: 2rem clamp(1.5rem, 5vw, 3.5rem);
  }

  .nav-primary {
    --gap: clamp(1.5rem, 5vw, 3.5rem);
    --underline-gap: 2rem;
    position: block;
    background: hsl(var(--color-dark) / 0.95);

    border-radius: 1em 0 0 1em;

    list-style: none;
    padding: 0;
    margin: 0;

    & li {
      flex-shrink: 0;
    }

    & a {
      display: inline-flex;
      align-items: baseline;
      gap: 0.5em;
      text-decoration: none;
      white-space: nowrap;
    }

    & a > span {
      margin-right: 0;
      font-weight: 700;
    }
  }

  .mobile-nav-toggle {
    display: none;
  }

  @supports (backdrop-filter: blur(1.5rem)) {
    .nav-primary {
      background: hsl(var(--color-white) / 0.05);
      backdrop-filter: blur(1.5rem);
    }
  }

  @media (max-width: 35rem) {
    .nav-primary {
      --underline-gap: 0.5rem;
      position: fixed;
      z-index: 1000;
      inset: 0 0 0 30%;

      list-style: none;
      padding: min(20rem, 15vh) 2rem;
      margin: 0;
      flex-direction: column;

      transform: translateX(100%);
      transition: transform 500ms ease-in-out;

      & li:not(.active) > a {
        color: hsl(var(--color-white) / 0.4);
      }

      &.underline-indicators > .active {
        border-bottom-color: transparent;
        border-left: 0.2rem solid hsl(var(--color-white));
        padding-inline-start: 0.75rem;
      }

      &.underline-indicators > li:not(.active):hover,
      &.underline-indicators > li:not(.active):focus-within {
        border-bottom-color: transparent;
      }

      &.underline-indicators > li:not(.active):hover > a,
      &.underline-indicators > li:not(.active):focus-within > a {
        color: hsl(var(--color-white) / 0.65);
      }

      &[data-visible='true'] {
        transform: translateX(0);
      }
    }

    .mobile-nav-toggle {
      display: block;
      position: absolute;
      z-index: 2000;
      right: 1rem;
      top: 2rem;
      background: transparent;
      background-image: url(/icons/icon-hamburger.svg);
      background-repeat: no-repeat;
      background-position: center;
      width: 1.5rem;
      aspect-ratio: 1;
      border: 0;

      &[aria-expanded='true'] {
        background-image: url(/icons/icon-close.svg);
      }

      &:focus-visible {
        outline: 5px solid white;
        outline-offset: 5px;
      }
    }
  }

  @media (min-width: 35em) {
    .nav-primary {
      padding-inline: clamp(3rem, 7vw, 7rem);
    }
  }

  @media (min-width: 35em) and (max-width: 44.999em) {
    .nav-primary {
      & a > span {
        display: none;
      }
    }
  }

  @media (min-width: 45em) {
    .header-primary::after {
      content: '';
      display: block;
      position: relative;
      height: 1px;
      width: 100%;
      opacity: 0.25;
      background: hsl(var(--color-accent));
      order: 1;
      z-index: 10;
      margin-right: -2.5rem;
    }

    nav {
      order: 2;
    }

    .nav-primary {
      margin-block: 2rem;
    }
  }
</style>

<script>
  const nav = document.querySelector('.nav-primary');
  const navToggle = document.querySelector('.mobile-nav-toggle');

  navToggle?.addEventListener('click', () => {
    const visible = nav?.getAttribute('data-visible');

    if (visible === 'false') {
      nav?.setAttribute('data-visible', 'true');
      navToggle?.setAttribute('aria-expanded', 'true');
    } else {
      nav?.setAttribute('data-visible', 'false');
      navToggle?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
