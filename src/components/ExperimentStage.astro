---
type PreviewMode = 'live' | 'poster' | 'none';

type Props = {
  preview: PreviewMode;
  slug: string;
  title: string;
  thumbnail?: string;
};

const { preview, slug, title, thumbnail } = Astro.props;
const embedSrc = `/experiments/embed/${slug}`;
---

<div
  class='experiment-stage'
  role='region'
  aria-label='Experiment preview'
  data-preview={preview}
>
  {
    preview === 'live' && (
      <iframe
        class='experiment-stage__iframe'
        title={`${title} preview`}
        src={embedSrc}
        loading='lazy'
        sandbox='allow-scripts allow-same-origin'
      />
    )
  }
  {
    preview === 'poster' && thumbnail && (
      <figure class='experiment-stage__poster'>
        <img src={thumbnail} alt='' width='640' height='360' loading='lazy' />
      </figure>
    )
  }
  {
    preview === 'none' && (
      <p class='experiment-stage__empty color-light font-mono uppercase text-200'>
        No live preview on this index — use links above if available.
      </p>
    )
  }
</div>

<style>
  .experiment-stage {
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 1px solid hsl(var(--color-white) / 0.08);
    border-radius: 8px;
    background: hsl(var(--color-dark) / 0.35);
  }

  .experiment-stage__iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .experiment-stage__poster {
    margin: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem;
    box-sizing: border-box;
  }

  .experiment-stage__poster img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 6px;
    border: 1px solid hsl(var(--color-white) / 0.1);
  }

  .experiment-stage__empty {
    margin: 0;
    padding: 1.5rem;
    text-align: center;
    max-width: 28ch;
  }
</style>
