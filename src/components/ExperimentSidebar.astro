---
type Item = { slug: string; title: string };

type Props = {
  items: Item[];
  activeSlug: string;
  showAllLink?: boolean;
};

const { items, activeSlug, showAllLink = false } = Astro.props;
const listId = 'experiment-sidebar-list';
---

{
  items.length > 0 && (
    <>
      <div class='experiment-sidebar-bar'>
        <div class="experiment-sidebar-bar__header"
        >
          Pick an experiment
        </div>
      </div>

      <nav
        id='experiment-sidebar-panel'
        class='experiment-sidebar'
        aria-label='Pick an experiment'
        data-visible='false'
      >
        <p class='experiment-sidebar__header'>Pick an experiment</p>

        <ul id={listId} class='experiment-sidebar__list'>
          {
            items.map((item) => (
              <li>
                <button
                  type='button'
                  class='experiment-sidebar__link font-condensed uppercase color-white tracking-xl'
                  data-slug={item.slug}
                  aria-current={item.slug === activeSlug ? 'true' : 'false'}
                  title={item.title}
                >
                  {item.title}
                </button>
              </li>
            ))
          }
        </ul>
        {
          showAllLink && (
            <a class='experiment-sidebar__all font-mono uppercase color-light' href='/experiments/all'>
              All experiments →
            </a>
          )
        }
      </nav>
    </>
  )
}

<script>
  const toggle = document.querySelector('.experiment-sidebar-bar__button');
  const panel = document.getElementById('experiment-sidebar-panel');

  toggle?.addEventListener('click', () => {
    const open = panel?.getAttribute('data-visible') === 'true';
    panel?.setAttribute('data-visible', open ? 'false' : 'true');
    toggle.setAttribute('aria-expanded', open ? 'false' : 'true');
  });
</script>

<style>
  .experiment-sidebar {
    list-style: none;
    background: hsl(var(--color-) / 0.95);
    border-radius: 0 1em 1em 0;
    padding-block: 1.25rem;
    padding-inline: clamp(1.25rem, 3vw, 2rem) clamp(1.5rem, 4vw, 2.5rem);
    margin: 0;
    z-index: 100;
    box-sizing: border-box;
  }

  @supports (backdrop-filter: blur(1.5rem)) {
    .experiment-sidebar {
      background: hsl(var(--color-white) / 0.05);
      backdrop-filter: blur(1.5rem);
    }
  }

  .experiment-sidebar__header {
    margin: 0 0 1rem;
    color: hsl(var(--color-light));
    padding-bottom: 0.75rem;
    border-bottom: 1px solid hsl(var(--color-white) / 0.1);
    font-family: var(--font-family-mono);
    font-size: var(--text-400);
    font-weight: medium;
    text-transform: uppercase;
    letter-spacing: var(--tracking-sm);
    cursor: default;
    user-select: none;
  }

  .experiment-sidebar__list {
    list-style: none;
    margin: 0;
    padding: 0;
    min-height: 0;
    overflow-y: auto;
  }

  .experiment-sidebar__link {
    display: block;
    width: 100%;
    max-width: 100%;
    text-align: start;
    padding: 0.65rem 1rem;
    border: 0;
    background: transparent;
    color: hsl(var(--color-white) / 0.4);
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .experiment-sidebar__link[aria-current='true'] {
    background: hsl(var(--color-white) / 0.06);
    border-inline-start: 0.2rem solid hsl(var(--color-white));
    padding-inline-start: calc(1rem - 0.2rem);
    color: hsl(var(--color-white));
    border-top-right-radius: 0.35em;
    border-bottom-right-radius: 0.35em;
  }

  .experiment-sidebar__link:hover,
  .experiment-sidebar__link:focus-visible {
    background: hsl(var(--color-white) / 0.04);
  }

  .experiment-sidebar__link:hover:not([aria-current='true']),
  .experiment-sidebar__link:focus-visible:not([aria-current='true']) {
    color: hsl(var(--color-white) / 0.65);
  }

  .experiment-sidebar__all {
    display: inline-block;
    width: 100%;
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid hsl(var(--color-white) / 0.2);
    text-decoration: none;
  }

  .experiment-sidebar__all:hover,
  .experiment-sidebar__all:focus-visible {
    color: hsl(var(--color-white));
  }

  .experiment-sidebar__all:visited {
    color: hsl(var(--color-white) / 0.2);
  }

  .experiment-sidebar-bar {
    display: none;
  }

  .experiment-sidebar-bar__button {
    width: 100%;
    border: 0;
    background: hsl(var(--color-white) / 0.08);
    color: inherit;
    cursor: pointer;
    padding: 0.85rem 1rem;
    border-radius: 0.35em;
    text-align: center;
  }

  .experiment-sidebar-bar__button:hover,
  .experiment-sidebar-bar__button:focus-visible {
    background: hsl(var(--color-white) / 0.12);
  }

  @media (min-width: 45em) {
    .experiment-sidebar {
      width: 100%;
      max-width: var(--experiment-sidebar-width);
      height: auto;
      max-height: 100%;
      overflow-y: auto;
      align-self: start;
      box-sizing: border-box;
    }

    .experiment-sidebar__list {
      overflow-y: visible;
    }
  }

  @media (max-width: 44.999em) {
    .experiment-sidebar-bar {
      display: block;
      position: fixed;
      z-index: 900;
      left: 0;
      right: 0;
      bottom: 0;
      padding: 0.65rem 1rem calc(0.65rem + env(safe-area-inset-bottom, 0px));
      background: hsl(var(--color-dark) / 0.95);
      border-top: 1px solid hsl(var(--color-white) / 0.1);
    }

    @supports (backdrop-filter: blur(1.5rem)) {
      .experiment-sidebar-bar {
        background: hsl(var(--color-white) / 0.05);
        backdrop-filter: blur(1.5rem);
      }
    }

    .experiment-sidebar {
      position: fixed;
      inset: 0 15% 0 0;
      z-index: 1000;
      border-radius: 0 1em 1em 0;
      padding-top: min(12rem, 18vh);
      transform: translateX(-100%);
      transition: transform 500ms ease-in-out;
    }

    .experiment-sidebar[data-visible='true'] {
      transform: translateX(0);
    }
  }
</style>
