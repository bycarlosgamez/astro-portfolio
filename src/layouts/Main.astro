---
import HeaderPrimary from '../components/HeaderPrimary.astro';

import '../styles/global.css';

type NavSection = 'home' | 'experiments' | 'projects' | 'about';

type Props = {
  title?: string;
  bodyClass?: string;
};

const { title = 'Carlos Gamez', bodyClass = '' } = Astro.props;

const bodyClassToNav: Partial<Record<string, NavSection>> = {
  home: 'home',
  experiments: 'experiments',
  projects: 'projects',
  about: 'about',
  'case-study': 'projects',
};

const currentSection = bodyClass
  .split(/\s+/)
  .map((token) => bodyClassToNav[token])
  .find((section): section is NavSection => section !== undefined);
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <meta name='generator' content={Astro.generator} />
    <meta name='description' content='Carlos Gamez | Design Engineer' />

    <title>{title}</title>

    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link
      href='https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&family=IBM+Plex+Sans+Condensed:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&family=IBM+Plex+Sans:ital,wght@0,100..700;1,100..700&display=swap'
      rel='stylesheet'
    />
    <script defer src="https://cloud.umami.is/script.js" data-website-id="6c895074-705d-481b-8dce-78dc9005eced"></script>
  </head>
  <body class={bodyClass}>
    <HeaderPrimary currentSection={currentSection} />
    <slot />
  </body>
</html>
