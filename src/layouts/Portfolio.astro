---
import type { MarkdownLayoutProps } from 'astro';
import Main from './Main.astro';

type Props = MarkdownLayoutProps<{
  title: string;
  subtitle: string;
  poster: string;
}>;

const { title, subtitle, poster } = Astro.props.frontmatter;
---

<Main title='Carlos Gamez | Porfolio' bodyClass='home'>
  <figure class='figure'>
    <img src={poster} alt='' width='100%' class='figure__image' />
    <figcaption class='figure__caption'>
      Poster image for {title.toLowerCase()}
    </figcaption>
  </figure>

  <h1>{title}</h1>
  <h2>{subtitle}</h2>

  <slot />
</Main>

<style>
  h1 + h2 {
    margin-bottom: 2.5rem;
  }

  .figure {
    margin: 0;
    margin-bottom: 3rem;
  }

  .figure__image {
    max-width: 100%;
    object-fit: cover;
    border-radius: 10px;
  }

  .figure__caption {
    margin: 0 auto;
    text-align: center;
    font-size: 0.9rem;
  }
</style>
