---
import Main from './Main.astro';

type Props = {
  title: string;
  subtitle: string;
  poster: string;
};

const { title, subtitle, poster } = Astro.props;
---

<Main title={`Carlos Gamez | ${title}`} bodyClass='case-study'>
  <main id='main' class='flow'>
    <figure class='figure'>
      <img src={poster} alt='' width='100%' class='figure__image' />
      <figcaption class='figure__caption'>
        Poster image for {title.toLowerCase()}
      </figcaption>
    </figure>

    <h1>{title}</h1>
    <h2>{subtitle}</h2>

    <div class='case-study-body flow'>
      <slot />
    </div>

    <p>
      <a class='font-mono uppercase color-light' href='/projects'
        >← Back to projects</a
      >
    </p>
  </main>
</Main>

<style>
  main {
    max-width: 65ch;
    margin-inline: auto;
    padding-inline: var(--gutter, 1.5rem);
    padding-block: 2rem 4rem;
  }

  h1 + h2 {
    margin-bottom: 2.5rem;
  }

  .figure {
    margin: 0;
    margin-bottom: 3rem;
  }

  .figure__image {
    max-width: 100%;
    object-fit: cover;
    border-radius: 10px;
  }

  .figure__caption {
    margin: 0 auto;
    text-align: center;
    font-size: 0.9rem;
  }
</style>
